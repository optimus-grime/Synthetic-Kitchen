rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {uid}
    // Fields: uid, email, displayName, photoURL, role
    //
    // Collection: inventory
    // Document ID: {itemId}
    // Fields: id, name, quantity, unit, category, expiryDate, lowStockThreshold, image, uid
    //
    // Collection: recipes
    // Document ID: {recipeId}
    // Fields: id, title, description, image, prepTime, calories, ingredients, instructions, tags, isFavorite, uid
    //
    // Collection: meals
    // Document ID: {mealId}
    // Fields: id, date, type, recipeId, recipeTitle, recipeImage, calories, prepTime, uid
    //
    // Collection: grocery
    // Document ID: {itemId}
    // Fields: id, name, amount, unit, category, completed, uid
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (request.auth.token.email == "steveo.04@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.uid is string && data.email is string;
    }

    function isValidInventoryItem(data) {
      return data.keys().hasAll(['name', 'quantity', 'unit', 'uid']) &&
             data.name is string && data.name.size() < 100 &&
             data.quantity is number &&
             data.unit is string &&
             data.uid == request.auth.uid;
    }

    function isValidRecipe(data) {
      return data.keys().hasAll(['title', 'uid']) &&
             data.title is string && data.title.size() < 200 &&
             data.uid == request.auth.uid;
    }

    function isValidMeal(data) {
      return data.keys().hasAll(['date', 'type', 'uid']) &&
             data.date is string &&
             data.type in ['breakfast', 'lunch', 'dinner', 'snack'] &&
             data.uid == request.auth.uid;
    }

    function isValidGroceryItem(data) {
      return data.keys().hasAll(['name', 'uid']) &&
             data.name is string && data.name.size() < 100 &&
             data.uid == request.auth.uid;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(request.resource.data) && (request.resource.data.role == 'user' || isAdmin());
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && (request.resource.data.role == resource.data.role || isAdmin());
    }

    match /inventory/{itemId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidInventoryItem(request.resource.data) && uidUnchanged();
      allow update: if isDocOwner() && isValidInventoryItem(request.resource.data) && uidNotModified();
      allow delete: if isDocOwner() || isAdmin();
    }

    match /recipes/{recipeId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidRecipe(request.resource.data) && uidUnchanged();
      allow update: if isDocOwner() && isValidRecipe(request.resource.data) && uidNotModified();
      allow delete: if isDocOwner() || isAdmin();
    }

    match /meals/{mealId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidMeal(request.resource.data) && uidUnchanged();
      allow update: if isDocOwner() && isValidMeal(request.resource.data) && uidNotModified();
      allow delete: if isDocOwner() || isAdmin();
    }

    match /grocery/{itemId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidGroceryItem(request.resource.data) && uidUnchanged();
      allow update: if isDocOwner() && isValidGroceryItem(request.resource.data) && uidNotModified();
      allow delete: if isDocOwner() || isAdmin();
    }
  }
}
